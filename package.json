{
  "name": "myapp",
  "version": "1.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder -p never"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "png-to-ico": "^3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.102.0",
    "typescript": "^5",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.nerdblud.viddax",
    "productName": "Viddax",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NerdBlud",
        "repo": "Viddax"
      }
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "bin/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "artifactName": "Viddax v${version} Installer.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.9"
  }
}
